{
  "name": "higgtable",
  "version": "1.7.3",
  "description": "Airtable file renaming tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "prebuild": "npm run fetch-ffmpeg",
    "build": "electron-builder --mac",
    "prebuild:win": "npm run fetch-ffmpeg",
    "build:win": "electron-builder --win",
    "prebuild:all": "npm run fetch-ffmpeg",
    "build:all": "electron-builder --mac --win",
    "prerelease": "npm run fetch-ffmpeg",
    "release": "electron-builder --mac --win --publish always",
    "prerelease:mac": "npm run fetch-ffmpeg",
    "release:mac": "electron-builder --mac --publish always",
    "prerelease:win": "npm run fetch-ffmpeg",
    "release:win": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.internal.higgtable",
    "productName": "HiggTable",
    "files": [
      "**/*",
      "!config.js",
      "!docs/**",
      "!tests/**",
      "!*.md",
      "!vendor/**",
      "!scripts/**",
      "!.superpowers/**",
      "!.claude/**"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}-${arch}",
        "to": "bin",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "CYBEROUT-me",
      "repo": "higgtable",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "image-size": "^2.0.2"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ]
  }
}
